    {
      "id": "mechanism.65.job-series-counter.3ef7",
      "title": "兵种相克百分比表与物理伤害乘算",
      "aliases": [
        "job-series-counter",
        "兵种相克",
        "兵种系相克",
        "相克百分比"
      ],
      "versions": ["6.4", "6.5", "6.6"],
      "profile": "profile.ccz65.unencrypted.3ef7",
      "status": "canonical",
      "evidence": "static-verified",
      "summary": "兵种相克是 EXE 内嵌的 40×40 字节表，索引为攻击方兵种系×40+防守方兵种系，值为百分比（100 中性）。物理伤害在基础值、能力差与随机修正之后按该百分比乘算，非 100 时结果至少为 1。三基底共用字节完全一致的查表与乘算代码，但表值分别不同。",
      "tableLayout": {
        "key": "job-series-counter",
        "file": "Ekd5.exe",
        "fileOffset": "0xA3280",
        "va": "0x4D1A80",
        "rows": 40,
        "columns": 40,
        "rowStride": 40,
        "indexFormula": "index = 40 * series(attacker) + series(defender)"
      },
      "seriesMapping": {
        "function": "0x40BF0C",
        "input": "单位记录 byte[+0x2B]（兵种 ID 0..79）",
        "rules": [
          "id <= 59：series = id / 3",
          "60 <= id <= 79：series = id - 40",
          "id >= 80：series = 40（越界哨兵）"
        ],
        "interpretation": "前 20 个兵种系各 3 个兵种，后 20 个兵种系各 1 个兵种。"
      },
      "lookup": {
        "va": "0x426737",
        "steps": [
          "series(second) * 40 + series(first)",
          "movzx byte[table + index]",
          "加上 property(second) - property(first)",
          "小于 0 时钳制为 0"
        ],
        "propertyDelta": {
          "getter": "0x413272",
          "args": "0x4101D9(unit, 0x76, 0x4E, 1, 0)",
          "status": "属性 0x76 未命名；双方默认时差值抵消"
        },
        "byteIdentity": "0x426737 与 0x40BF0C 在三基底字节完全一致。"
      },
      "callConvention": {
        "order": "调用点先压防守方，再压攻击方；0x426737 的 [ebp+8] 为防守方、[ebp+0xC] 为攻击方。",
        "consequence": "表行号为攻击方兵种系，列号为防守方兵种系。"
      },
      "damageApplication": {
        "va": "0x43BD9B",
        "formula": "damage = (counter == 100) ? damage : max(1, damage * counter / 100)",
        "helper": "0x425AD9(a,b)=a*b/100（整数除法）",
        "position": "位于物理伤害基础值/能力差/随机修正之后，0x4E6000 最终处理之前。",
        "versions": "6.4/6.5/6.6 同址同结构。"
      },
      "valueDistribution": {
