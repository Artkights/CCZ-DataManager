        "axis": "byte[defender+0xF]&1：0=Y 轴，1=X 轴",
        "class": "相等=1；按方向与坐标大小得到 0 或 2",
        "apply": "hit += hit * class * 5 / 100",
        "extra": "0x406710(defender)!=1 且 byte[0x500E9A]==1 → 再 +5%"
