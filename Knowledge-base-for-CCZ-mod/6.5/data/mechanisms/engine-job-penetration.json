      "summary": "0x407881 是 80 字节的兵种属性码表，按兵种 ID（unit+0x2B）索引。0x40782D 在模式/状态/哨兵检查通过后返回 table[jobId]；0 为缺省，6.5 还出现 1/4/9/10，6.6 出现 1/4/7/9。",
      "tableLayout": {"file": "Ekd5.exe", "fileOffset": "0x6C81", "va": "0x407881", "rows": 80, "width": 1},
      "function": {
        "va": "0x40782D",
        "jobGetter": "0x406610 = byte[unit+0x2B]",
        "guards": [
          "byte[0x505FDC] != 0 → 0",
          "byte[0x500E9A] == 2 且特殊检查为真 → 0",
          "0x40CC13(unit,0x33,0,5) != 0 → 0",
          "jobId >= 0x50 → 0"
        ],
        "return": "byte[0x407881 + jobId]"
      },
